// pixel: an 8-bit handheld, four greens and pixelated edges.
// Needs a Nerd Font and a truecolor terminal.
.{
    .order = .{ .text, .dir, .git_branch, .git_status, .duration, .status, .jobs, .character },
    .segments = .{ .open = "\u{e0c7}", .join = "\u{e0c6}", .close = "\u{e0c6}", .padding = " " },
    .text = .{ .pieces = .{.{ .text = "▞▚", .style = .{ .fg = "#8bac0f" } }} },
    .dir = .{ .style = .{ .fg = "#9bbc0f", .bg = "#306230", .bold = true }, .max_length = 0 },
    .git_branch = .{ .style = .{ .fg = "#0f380f", .bg = "#8bac0f", .bold = true } },
    .git_status = .{ .style = .{ .fg = "#0f380f", .bg = "#9bbc0f", .bold = true } },
    .duration = .{ .style = .{ .fg = "#9bbc0f", .bg = "#0f380f" } },
    .status = .{ .style = .{ .fg = "#9bbc0f", .bg = "#0f380f", .bold = true, .inverse = false } },
    .jobs = .{ .style = .{ .fg = "#0f380f", .bg = "#8bac0f" } },
    .character = .{
        .success_symbol = "▶",
        .failure_symbol = "▶",
        .success_style = .{ .fg = "#9bbc0f", .bold = true },
        .failure_style = .{ .fg = "#306230", .bold = true },
    },
}
