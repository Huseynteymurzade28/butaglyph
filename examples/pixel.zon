// pixel: an 8-bit handheld, four greens and dithered edges.
// Needs a truecolor terminal.
.{
    .order = .{ .text, .dir, .git_branch, .git_status, .python, .node, .rust, .go, .zig, .java, .ruby, .php, .deno, .bun, .dotnet, .lua, .haskell, .aws, .duration, .status, .jobs, .character },
    .segments = .{ .open = "▗▞", .join = "▞", .close = "▚▖", .padding = " " },
    .text = .{ .pieces = .{.{ .text = "▞▚", .style = .{ .fg = "#8bac0f" } }} },
    .dir = .{ .style = .{ .fg = "#9bbc0f", .bg = "#306230", .bold = true }, .max_length = 0 },
    .git_branch = .{ .style = .{ .fg = "#0f380f", .bg = "#8bac0f", .bold = true } },
    .git_status = .{ .style = .{ .fg = "#0f380f", .bg = "#9bbc0f", .bold = true } },
    .python = .{ .style = .{ .fg = "#9bbc0f", .bg = "#306230", .bold = true } },
    .node = .{ .style = .{ .fg = "#9bbc0f", .bg = "#306230", .bold = true } },
    .rust = .{ .style = .{ .fg = "#9bbc0f", .bg = "#306230", .bold = true } },
    .go = .{ .style = .{ .fg = "#9bbc0f", .bg = "#306230", .bold = true } },
    .zig = .{ .style = .{ .fg = "#9bbc0f", .bg = "#306230", .bold = true } },
    .java = .{ .style = .{ .fg = "#9bbc0f", .bg = "#306230", .bold = true } },
    .ruby = .{ .style = .{ .fg = "#9bbc0f", .bg = "#306230", .bold = true } },
    .php = .{ .style = .{ .fg = "#9bbc0f", .bg = "#306230", .bold = true } },
    .deno = .{ .style = .{ .fg = "#9bbc0f", .bg = "#306230", .bold = true } },
    .bun = .{ .style = .{ .fg = "#9bbc0f", .bg = "#306230", .bold = true } },
    .dotnet = .{ .style = .{ .fg = "#9bbc0f", .bg = "#306230", .bold = true } },
    .lua = .{ .style = .{ .fg = "#9bbc0f", .bg = "#306230", .bold = true } },
    .haskell = .{ .style = .{ .fg = "#9bbc0f", .bg = "#306230", .bold = true } },
    .aws = .{ .style = .{ .fg = "#9bbc0f", .bg = "#306230", .bold = true } },
    .duration = .{ .style = .{ .fg = "#9bbc0f", .bg = "#0f380f" } },
    .status = .{ .style = .{ .fg = "#9bbc0f", .bg = "#0f380f", .bold = true, .inverse = false } },
    .jobs = .{ .style = .{ .fg = "#0f380f", .bg = "#8bac0f" } },
    .character = .{
        .success_symbol = "▶",
        .failure_symbol = "▶",
        .success_style = .{ .fg = "#9bbc0f", .bold = true },
        .failure_style = .{ .fg = "#306230", .bold = true },
    },
}
