// carpet: butaglyph's own look, in the colors of an Azerbaijani carpet.
// Madder red, indigo, saffron, teal and ivory woven into segments, with a
// buta (the teardrop motif the project is named after) at each end.
// Stepped edges, like a carpet's border. Needs a truecolor terminal.
.{
    .order = .{ .text, .dir, .git_branch, .git_status, .python, .node, .rust, .go, .zig, .aws, .duration, .status, .jobs, .line_break, .character },
    .segments = .{ .open = "▗▟", .join = "▙▖", .close = "▙▖", .padding = " " },
    .text = .{ .pieces = .{.{ .text = "❧", .style = .{ .fg = "#e6a532", .bold = true } }} },
    .dir = .{
        .style = .{ .fg = "#f8ecd4", .bg = "#7a1424>#b8323b", .bold = true },
        .separator = " › ",
        .max_length = 36,
    },
    .git_branch = .{ .style = .{ .fg = "#f0b43c", .bg = "#24306e", .bold = true } },
    .git_status = .{ .style = .{ .fg = "#f8ecd4", .bg = "#1f6f6a" } },
    .python = .{ .style = .{ .fg = "#f8ecd4", .bg = "#2f5d3a", .bold = true } },
    .node = .{ .style = .{ .fg = "#f8ecd4", .bg = "#2f5d3a", .bold = true } },
    .rust = .{ .style = .{ .fg = "#f8ecd4", .bg = "#2f5d3a", .bold = true } },
    .go = .{ .style = .{ .fg = "#f8ecd4", .bg = "#2f5d3a", .bold = true } },
    .zig = .{ .style = .{ .fg = "#f8ecd4", .bg = "#2f5d3a", .bold = true } },
    .aws = .{ .style = .{ .fg = "#f8ecd4", .bg = "#2f5d3a", .bold = true } },
    .duration = .{ .style = .{ .fg = "#24306e", .bg = "#e6a532", .bold = true } },
    .status = .{ .style = .{ .fg = "#f8ecd4", .bg = "#4a0d16", .bold = true } },
    .jobs = .{ .style = .{ .fg = "#24306e", .bg = "#f8ecd4" } },
    .character = .{
        .success_symbol = "╰─❧",
        .failure_symbol = "╰─❧",
        .success_style = .{ .fg = "#b8323b>#e6a532", .bold = true },
        .failure_style = .{ .fg = "#e74c3c", .bold = true },
    },
}
