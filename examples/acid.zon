// acid: rainbows, flames and blinking. Too much, on purpose.
// Rainbow segments with equalizer edges, a branch name in every color at once,
// a status that blinks. Needs a truecolor terminal.
.{
    .order = .{ .text, .dir, .git_branch, .git_status, .python, .node, .rust, .go, .zig, .aws, .duration, .status, .jobs, .line_break, .character },
    .segments = .{ .open = "▁▃▅▇", .join = "▇▅▃▁", .close = "▇▅▃▁", .padding = " " },
    .text = .{ .pieces = .{.{ .text = "✺", .style = .{ .fg = "rainbow", .bold = true } }} },
    .dir = .{
        .style = .{ .fg = "#000000", .bg = "rainbow", .bold = true },
        .separator = " ⟡ ",
        .max_length = 0,
    },
    .git_branch = .{ .style = .{ .fg = "rainbow", .bg = "#000000", .bold = true, .italic = true } },
    .git_status = .{ .style = .{ .fg = "#000000", .bg = "#39ff14>#ff00ff", .bold = true } },
    .python = .{ .style = .{ .fg = "#000000", .bg = "#00ffff>#39ff14", .bold = true, .italic = true } },
    .node = .{ .style = .{ .fg = "#000000", .bg = "#00ffff>#39ff14", .bold = true, .italic = true } },
    .rust = .{ .style = .{ .fg = "#000000", .bg = "#00ffff>#39ff14", .bold = true, .italic = true } },
    .go = .{ .style = .{ .fg = "#000000", .bg = "#00ffff>#39ff14", .bold = true, .italic = true } },
    .zig = .{ .style = .{ .fg = "#000000", .bg = "#00ffff>#39ff14", .bold = true, .italic = true } },
    .aws = .{ .style = .{ .fg = "#000000", .bg = "#00ffff>#39ff14", .bold = true, .italic = true } },
    .duration = .{ .style = .{ .fg = "#000000", .bg = "#ffff00", .bold = true, .italic = true } },
    .status = .{ .style = .{ .fg = "#ffff00", .bg = "#ff0000", .bold = true, .blink = true } },
    .jobs = .{ .style = .{ .fg = "#000000", .bg = "#00ffff" } },
    .character = .{
        .success_symbol = "⟫⟫⟫⟫",
        .failure_symbol = "✖✖✖✖",
        .success_style = .{ .fg = "rainbow", .bold = true },
        .failure_style = .{ .fg = "#ff0000>#ffff00", .bold = true, .blink = true },
    },
}
