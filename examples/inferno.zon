// inferno: the prompt is on fire, from coal red to white heat.
// Flames rise out of the floor into the segments.
// Needs a truecolor terminal.
.{
    .order = .{ .dir, .git_branch, .git_status, .python, .node, .rust, .go, .zig, .java, .ruby, .php, .deno, .bun, .dotnet, .lua, .haskell, .aws, .duration, .status, .jobs, .line_break, .character },
    .segments = .{ .open = "▁▂▃▅▆▇", .join = "▇▆▅▃▂▁", .close = "▇▆▅▃▂▁", .padding = " " },
    .dir = .{ .style = .{ .fg = "#fff3c4", .bg = "#3a0000>#a10000", .bold = true }, .separator = " ≀ " },
    .git_branch = .{ .style = .{ .fg = "#fff3c4", .bg = "#a10000>#e03000", .bold = true } },
    .git_status = .{ .style = .{ .fg = "#2a0000", .bg = "#e03000>#ff7a00", .bold = true } },
    .python = .{ .style = .{ .fg = "#2a0000", .bg = "#ff7a00", .bold = true } },
    .node = .{ .style = .{ .fg = "#2a0000", .bg = "#ff7a00", .bold = true } },
    .rust = .{ .style = .{ .fg = "#2a0000", .bg = "#ff7a00", .bold = true } },
    .go = .{ .style = .{ .fg = "#2a0000", .bg = "#ff7a00", .bold = true } },
    .zig = .{ .style = .{ .fg = "#2a0000", .bg = "#ff7a00", .bold = true } },
    .java = .{ .style = .{ .fg = "#2a0000", .bg = "#ff7a00", .bold = true } },
    .ruby = .{ .style = .{ .fg = "#2a0000", .bg = "#ff7a00", .bold = true } },
    .php = .{ .style = .{ .fg = "#2a0000", .bg = "#ff7a00", .bold = true } },
    .deno = .{ .style = .{ .fg = "#2a0000", .bg = "#ff7a00", .bold = true } },
    .bun = .{ .style = .{ .fg = "#2a0000", .bg = "#ff7a00", .bold = true } },
    .dotnet = .{ .style = .{ .fg = "#2a0000", .bg = "#ff7a00", .bold = true } },
    .lua = .{ .style = .{ .fg = "#2a0000", .bg = "#ff7a00", .bold = true } },
    .haskell = .{ .style = .{ .fg = "#2a0000", .bg = "#ff7a00", .bold = true } },
    .aws = .{ .style = .{ .fg = "#2a0000", .bg = "#ff7a00", .bold = true } },
    .duration = .{ .style = .{ .fg = "#2a0000", .bg = "#ffb000>#ffe000", .bold = true } },
    .status = .{ .style = .{ .fg = "#3a0000", .bg = "#fff3c4", .bold = true } },
    .jobs = .{ .style = .{ .fg = "#3a0000", .bg = "#ffe000" } },
    .character = .{
        .success_symbol = "╰≋⟿",
        .failure_symbol = "╰≋⟿",
        .success_style = .{ .fg = "#a10000>#ff7a00>#ffe000", .bold = true },
        .failure_style = .{ .fg = "#ffffff>#ff0000", .bold = true },
    },
}
