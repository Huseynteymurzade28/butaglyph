// bubbles: pastel pills, one per module.
// Needs a truecolor terminal.
.{
    .order = .{ .dir, .git_branch, .git_status, .python, .node, .rust, .go, .zig, .java, .ruby, .php, .deno, .bun, .dotnet, .lua, .haskell, .aws, .duration, .status, .jobs, .character },
    .segments = .{ .open = "▐", .join = null, .close = "▌", .padding = " " },
    .dir = .{ .style = .{ .fg = "#1e1e2e", .bg = "#89b4fa", .bold = true } },
    .git_branch = .{ .style = .{ .fg = "#1e1e2e", .bg = "#cba6f7", .bold = true } },
    .git_status = .{ .style = .{ .fg = "#1e1e2e", .bg = "#f9e2af", .bold = true } },
    .python = .{ .style = .{ .fg = "#1e1e2e", .bg = "#fab387", .bold = true } },
    .node = .{ .style = .{ .fg = "#1e1e2e", .bg = "#fab387", .bold = true } },
    .rust = .{ .style = .{ .fg = "#1e1e2e", .bg = "#fab387", .bold = true } },
    .go = .{ .style = .{ .fg = "#1e1e2e", .bg = "#fab387", .bold = true } },
    .zig = .{ .style = .{ .fg = "#1e1e2e", .bg = "#fab387", .bold = true } },
    .java = .{ .style = .{ .fg = "#1e1e2e", .bg = "#fab387", .bold = true } },
    .ruby = .{ .style = .{ .fg = "#1e1e2e", .bg = "#fab387", .bold = true } },
    .php = .{ .style = .{ .fg = "#1e1e2e", .bg = "#fab387", .bold = true } },
    .deno = .{ .style = .{ .fg = "#1e1e2e", .bg = "#fab387", .bold = true } },
    .bun = .{ .style = .{ .fg = "#1e1e2e", .bg = "#fab387", .bold = true } },
    .dotnet = .{ .style = .{ .fg = "#1e1e2e", .bg = "#fab387", .bold = true } },
    .lua = .{ .style = .{ .fg = "#1e1e2e", .bg = "#fab387", .bold = true } },
    .haskell = .{ .style = .{ .fg = "#1e1e2e", .bg = "#fab387", .bold = true } },
    .aws = .{ .style = .{ .fg = "#1e1e2e", .bg = "#fab387", .bold = true } },
    .duration = .{ .style = .{ .fg = "#1e1e2e", .bg = "#94e2d5", .bold = true } },
    .status = .{ .style = .{ .fg = "#1e1e2e", .bg = "#f38ba8", .bold = true } },
    .jobs = .{ .style = .{ .fg = "#1e1e2e", .bg = "#a6e3a1", .bold = true } },
    .character = .{
        .success_symbol = "❯",
        .failure_symbol = "❯",
        .success_style = .{ .fg = "#a6e3a1", .bold = true },
        .failure_style = .{ .fg = "#f38ba8", .bold = true },
    },
}
